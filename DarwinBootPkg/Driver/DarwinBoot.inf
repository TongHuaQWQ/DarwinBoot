## SPDX-License-Identifier: BSD-2-Clause-Patent
[Defines]
  INF_VERSION = 0x00010019
  BASE_NAME = DarwinBoot
  FILE_GUID = 1B64AF87-8415-4B57-9B16-680D70913B9F
  MODULE_TYPE = UEFI_DRIVER
  VERSION_STRING = 0.1
  ENTRY_POINT = DarwinBootEntry

[Sources]
  DarwinBoot.c
  PackedRamdisk.h
  BootArgs.h
  BootVideo.h
  DiagFont.h
  Entry.S
  # LZMA decoder for "<kernel>.lzma": a prelinked macOS kernel collection is 132.8 MiB and
  # vendor_boot_a is 96 MiB, so the payload carries it compressed. Vendored from MdeModulePkg's
  # LzmaCustomDecompressLib (public-domain LZMA SDK) instead of linked as a library class: the
  # library is NULL-class with a guided-section constructor this driver does not need.
  Lzma/DarwinBootLzma.c
  Lzma/DarwinBootLzma.h
  Lzma/LzmaDec.c
  Lzma/LzmaDec.h
  Lzma/7zTypes.h
  Lzma/Compiler.h
  Lzma/CpuArch.h
  Lzma/Precomp.h
  Lzma/UefiLzma.h

[Packages]
  MdePkg/MdePkg.dec
  UniXNUPkg/UniXNUPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gUniXNULoaderProtocolGuid ## PRODUCES
  gEfiSimpleFileSystemProtocolGuid ## CONSUMES
  gEfiLoadedImageProtocolGuid ## CONSUMES
  gEfiGraphicsOutputProtocolGuid ## CONSUMES

[Guids]
  gEfiFileInfoGuid
